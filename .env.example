# Local dev uses the Vite proxy in vite.config.js, so this can stay empty.
# Staging Docker/Nginx proxies /api to the backend on the same origin, so it can also stay empty.
# Set this only when the frontend is served by a different origin than the API.
# Example: VITE_API_BASE_URL=https://api.suplematch.example.com
VITE_API_BASE_URL=
